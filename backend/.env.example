APP_NAME=MediNavi
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
REDIS_URL=redis://localhost:6379/0
SESSION_TTL_SECONDS=1800
MAX_CHAT_TURNS=5
# clova_triage = hosAI 문진 엔진
AI_PROVIDER=clova_triage
# 문진 엔진 전용 CLOVA Studio 키 (약 설명용 CLOVA_API_KEY와 다른 키)
CLOVASTUDIO_API_KEY=
AI_REQUEST_TIMEOUT_SECONDS=30
AI_MOCK_ENABLED=false
MEDICATION_DATA_PROVIDER=demo
OCR_PROVIDER=clova
TTS_PROVIDER=disabled
CORS_ORIGINS=http://localhost:8501

CLOVA_OCR_INVOKE_URL=
CLOVA_OCR_SECRET=
OCR_REQUEST_TIMEOUT_SECONDS=30

MFDS_API_KEY=
CLOVA_API_KEY=
CLOVA_MODEL=HCX-005
MEDICATION_AI_ENABLED=true

# 병원 검색 (국립중앙의료원 API, 공공데이터포털 키)
DATA_GO_KR_KEY=
# 네이버 지도 역지오코딩 (좌표 → 시/구)
NCP_MAPS_CLIENT_ID=
NCP_MAPS_CLIENT_SECRET=
HOSPITAL_RADIUS_MAX_KM=10
HOSPITAL_MAX_RESULTS=20

# 질병관리청 건강정보 (승인 대기, 아직 미사용)
KDCA_API_KEY=

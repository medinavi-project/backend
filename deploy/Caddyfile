{
	email {$ACME_EMAIL}
}

medinavi.kro.kr {
	# kro.kr은 여러 사람이 같이 쓰는 도메인이라 Let's Encrypt 발급 한도가 차 있을 때가 있다.
	# ZeroSSL을 먼저 시도하고, 안 되면 Let's Encrypt로 받는다.
	tls {
		issuer acme https://acme.zerossl.com/v2/DV90
		issuer acme https://acme-v02.api.letsencrypt.org/directory
	}
	request_body {
		max_size 6MB
	}

	# 백엔드
	@backend path /api/* /health /docs /docs/* /openapi.json
	handle @backend {
		reverse_proxy api:8000 {
			transport http {
				read_timeout 150s
			}
		}
	}

	# 나머지는 프론트 (NCP Object Storage + Global Edge)
	handle {
		# 확장자 없는 화면 주소(/, /chat, /hospitals …)만 index.html로. 파일은 그대로 받는다.
		@spa path_regexp ^/[^.]*$
		rewrite @spa /index.html
		reverse_proxy https://cuxxcwed0dpds9j8zrlo16933.edge.naverncp.com {
			header_up Host cuxxcwed0dpds9j8zrlo16933.edge.naverncp.com
		}
	}
}
